{
  "name": "template-discordbot",
  "description": "An esm Bun template for discord bots using discord.js",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Mike Valeriano <dev@mkvlrn.cc>",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkvlrn/template-discordbot"
  },
  "keywords": [
    "bun",
    "esm",
    "discord",
    "discord.js",
    "bot",
    "template"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "ignore"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "ignore"
    }
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@mkvlrn/config": "0.9.2",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.16",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mkvlrn/result": "0.4.2",
    "@napi-rs/canvas": "1.0.10",
    "discord.js": "14.27.0",
    "pino": "10.4.0",
    "varlock": "1.21.1"
  }
}
